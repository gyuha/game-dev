---
import { SITE_TITLE } from '../consts';
import { url } from '../lib/utils';

const links = [
	{ href: url('blog/'), label: 'Posts' },
	{ href: url('tags/'), label: 'Tags' },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-20 border-b border-zinc-200 bg-white/80 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/80">
	<nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
		<a href={url()} class="flex items-center gap-2 font-mono text-lg font-bold tracking-tight">
			<img src={url('favicon.png')} alt="" width="28" height="28" class="h-7 w-7 object-contain" />
			{SITE_TITLE}
		</a>
		<div class="flex items-center gap-1 text-sm">
			{
				links.map((l) => (
					<a
						href={l.href}
						class:list={[
							'rounded-md px-3 py-1.5 hover:bg-zinc-100 dark:hover:bg-zinc-800',
							path.startsWith(l.href) && 'text-accent font-semibold',
						]}
					>
						{l.label}
					</a>
				))
			}
			<button
				id="theme-toggle"
				type="button"
				aria-label="테마 전환"
				class="rounded-md px-3 py-1.5 hover:bg-zinc-100 dark:hover:bg-zinc-800"
			>
				<span class="dark:hidden">☾</span><span class="hidden dark:inline">☀</span>
			</button>
		</div>
	</nav>
</header>

<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const dark = document.documentElement.classList.toggle('dark');
		localStorage.setItem('theme', dark ? 'dark' : 'light');
	});
</script>
