---
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts, url } from '../lib/utils';

const posts = await getPosts();
const latest = posts.slice(0, 6);
const countBy = (key: string) => posts.filter((p) => p.data.category === key).length;
---

<BaseLayout>
	<section class="relative overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-950 bg-cover bg-center px-8 py-16 text-white dark:border-zinc-800" style={`background-image: url('${url('images/home-hero.png')}')`}>
		<div class="absolute inset-0 bg-gradient-to-r from-zinc-950 via-zinc-950/80 to-zinc-950/15"></div>
		<div class="relative">
		<p class="font-mono text-sm text-accent">// game development notes</p>
		<h1 class="mt-3 text-4xl font-extrabold tracking-tight md:text-5xl">Game Dev Log</h1>
		<p class="mt-4 max-w-xl text-zinc-300">{SITE_DESCRIPTION}</p>
		<div class="mt-8 flex gap-3">
			<a href={url('blog/')} class="rounded-lg bg-accent px-5 py-2.5 font-semibold text-zinc-950 hover:opacity-90">글 보기</a>
			<a href={url('rss.xml')} class="rounded-lg border border-zinc-600 px-5 py-2.5 hover:border-accent">RSS 구독</a>
		</div>
		</div>
	</section>

	<section class="mt-14">
		<h2 class="text-2xl font-bold">카테고리</h2>
		<div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
			{
				Object.entries(CATEGORIES).map(([key, c]) => (
					<a href={url(`category/${key}/`)} class="rounded-xl border border-zinc-200 bg-white p-4 hover:border-accent dark:border-zinc-800 dark:bg-zinc-900">
						<div class="flex items-baseline justify-between">
							<span class="font-bold">{c.label}</span>
							<span class="font-mono text-xs text-zinc-500">{countBy(key)}</span>
						</div>
						<p class="mt-2 text-xs text-zinc-600 dark:text-zinc-400">{c.description}</p>
					</a>
				))
			}
		</div>
	</section>

	<section class="mt-14">
		<div class="flex items-baseline justify-between">
			<h2 class="text-2xl font-bold">최신 글</h2>
			<a href={url('blog/')} class="text-sm text-accent hover:underline">전체 보기 →</a>
		</div>
		<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{latest.map((post) => <PostCard post={post} />)}
		</div>
	</section>
</BaseLayout>
